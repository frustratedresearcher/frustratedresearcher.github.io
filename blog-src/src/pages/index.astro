---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SITE, seriesSlug } from '../consts';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Curated multi-part series, surfaced as a card so a 10-part series does not
// bury the chronological feed. Most-recently-updated series first.
const series = Object.values(
  posts.reduce((acc, p) => {
    const name = p.data.series;
    if (!name) return acc;
    (acc[name] ??= { name, slug: seriesSlug(name), count: 0, latest: p.data.pubDate }).count++;
    return acc;
  }, {})
).sort((a, b) => b.latest.valueOf() - a.latest.valueOf());

const fmt = (d) => d.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });

const listLd = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: posts.map((p, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    url: new URL(`${SITE.base}/${p.id}/`, SITE.url).href,
    name: p.data.title,
  })),
}];
---
<Base title={SITE.title} description={SITE.description} jsonLd={listLd}>
  <div class="page-head">
    <div class="kicker">$ ls -lt ~/notes</div>
    <h1>Notes</h1>
    <p class="sub">{SITE.description}</p>
  </div>

  {series.length > 0 && (
    <div class="series-cards">
      <div class="sc-head">Series</div>
      {series.map((s) => (
        <a class="sc" href={`${SITE.base}/series/${s.slug}/`}>
          <span class="sc-name">{s.name}</span>
          <span class="sc-meta">{s.count}-part series &rarr;</span>
        </a>
      ))}
    </div>
  )}

  <ul class="postlist">
    {posts.map((p) => (
      <li>
        <a class="row" href={`${SITE.base}/${p.id}/`}>
          <div class="meta">
            <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
            {p.data.series && <span class="series-chip">{p.data.series} · Part {p.data.seriesPart}</span>}
          </div>
          <h2>{p.data.title}</h2>
          <p class="dek">{p.data.description}</p>
          {p.data.tags.length > 0 && (
            <div class="tags">{p.data.tags.map((t) => <span class="tag">{t}</span>)}</div>
          )}
        </a>
      </li>
    ))}
  </ul>
</Base>
